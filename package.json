{
  "name": "terminal-emulator",
  "version": "1.0.0",
  "description": "A modern terminal emulator built with React Router v7, TypeScript, and TailwindCSS featuring Unix commands, I/O redirection, and Catppuccin theme",
  "keywords": [
    "terminal",
    "emulator",
    "react-router",
    "typescript",
    "catppuccin",
    "unix",
    "shell"
  ],
  "author": "ThibaultJRD",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "start:local": "react-router-serve ./build/server/nodejs_eyJydW50aW1lIjoibm9kZWpzIn0/index.js",
    "typecheck": "react-router typegen && tsc",
    "format": "prettier --write './**/*.{js,jsx,ts,tsx,css,md,html,json}' --config ./.prettierrc.json",
    "format:check": "prettier --check './**/*.{js,jsx,ts,tsx,css,md,html,json}' --config ./.prettierrc.json",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "yarn format:check && yarn typecheck && yarn test:run",
    "audit": "yarn audit",
    "audit:fix": "yarn audit --fix || npm audit fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@react-router/node": "^7.11.0",
    "@react-router/serve": "^7.11.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/react-router": "^1.2.4",
    "@vercel/speed-insights": "^1.3.1",
    "isbot": "^5.1.32",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router": "^7.11.0"
  },
  "devDependencies": {
    "@react-router/dev": "^7.11.0",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/node": "^20.19.27",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^4.0.16"
  }
}
